# =====================================================================================================
#  SketchFlow 3D setup settings
#  SF3d_setup.bat copies this file to SF3d_setup.env the first time it runs and opens it in Notepad.
#  Fill it in, save, and run SF3d_setup.bat again. SF3d_setup.env holds your token: it is ignored by
#  git and never uploaded. Lines starting with # are notes. Use 1 for yes and 0 for no.
# =====================================================================================================

# ----------------------------------------- What to do -----------------------------------------------
# Test, pack and install SketchFlow on this computer (the "sketchflow-mcp" command) and build the
# Claude Desktop bundle (release\sketchflow-<version>.mcpb).
DO_LOCAL_INSTALL=1

# Add SketchFlow to the AI apps chosen below.
DO_CONFIGURE_CLIENTS=1

# Set up a local model: Ollama + a model + the ollmcp client, and an SF3d_ollama.bat to start it.
DO_OLLAMA=0

# Launch the public beta: your GitHub repository, npm, and the MCP Registry.
#   0       = skip
#   prep    = only get this folder ready (commit identity, email in history, release prep, main branch)
#             and stop before anything is uploaded, so you can look first
#   1       = everything: create the repository, push, publish to npm, tag the release
DO_PUBLISH=0

# 1 = show what would be uploaded, published or rewritten without doing it. The local steps still run
#     (tests, install, app settings, the release-prep commit).
DRY_RUN=0

# 1 = don't ask before each upload or history change (only once you know the steps work).
ASSUME_YES=0

# ------------------------------------------- You ----------------------------------------------------
# Needed for DO_PUBLISH. Your GitHub user name (the one in github.com/<name>), not your email.
GITHUB_USER=

# The repository to create on GitHub (github.com/<GITHUB_USER>/<GITHUB_REPO>).
GITHUB_REPO=sketchflow

# public or private. The MCP Registry and npm users need it public.
REPO_VISIBILITY=public

# Your name, as the author on npm and in the commits.
AUTHOR_NAME=

# The email on your commits. A public repository shows it. To keep yours private, use GitHub's
# no-reply address from GitHub > Settings > Emails ("Keep my email addresses private"), which looks like
# 12345678+username@users.noreply.github.com
GIT_EMAIL=

# 1 = also put GIT_EMAIL on the commits already made (they show your current email). This rewrites the
# history, so it only runs before the first push. A backup is saved first in release\.
REWRITE_EMAIL_IN_HISTORY=0

# npm access token (npmjs.com > your avatar > Access Tokens > Generate New Token > Granular, with
# read and write access to packages). Leave it empty to sign in in the browser with "npm login" instead.
NPM_TOKEN=

# 1 = also store NPM_TOKEN in the GitHub repository (secret NPM_TOKEN), so later releases publish from
# GitHub by themselves when you push a version tag.
SET_NPM_TOKEN_SECRET=1

# Extra flags for npm publish, e.g. --otp=123456 if your npm account asks for a one-time code.
NPM_PUBLISH_ARGS=

# 1 = after pushing the release tag, wait for GitHub to finish the release (GitHub release, .mcpb,
# MCP Registry) and show the result.
WAIT_FOR_RELEASE=1

# ---------------------------------------- AI apps ---------------------------------------------------
# Which apps to add SketchFlow to (DO_CONFIGURE_CLIENTS=1). Each app's settings file is backed up first.
CLIENT_CLAUDE_DESKTOP=1
CLIENT_CLAUDE_CODE=1
CLIENT_CURSOR=0
CLIENT_VSCODE=0
CLIENT_LM_STUDIO=0

# Claude Desktop: config = write it into claude_desktop_config.json (restart Claude Desktop after)
#                 bundle = open the .mcpb so Claude Desktop shows its Install button
CLAUDE_DESKTOP_METHOD=config

# What the apps run:
#   local = the copy installed from this folder (works before anything is published)
#   npm   = the published beta, "npx -y sketchflow-mcp@beta" (after DO_PUBLISH; updates itself)
SOURCE=local

# ---------------------------------------- SketchFlow ------------------------------------------------
# Tool set: all (sketch board + 3D), 3d (only the 3D model) or 2d (only the sketch board).
TOOLS=all

# 1 = short instructions for the AI (for small local models).
BRIEF=0

# Where exports (PNG, SVG, STEP, STL, drawings) go. Empty = Pictures\SketchFlow.
EXPORT_DIR=

# 1 = also serve the board on your network so a tablet or phone can draw (it asks for a pairing code).
LAN=0

# First port to try (the next free one is used if it is taken).
PORT=7777

# ------------------------------------------ Ollama --------------------------------------------------
# A model that can call tools. ollmcp's docs list gemma4, qwen3.5, llama3.2 and mistral; 8B and larger
# handle 3D builds best.
OLLAMA_MODEL=qwen3.5

# Context window for Ollama (stored as OLLAMA_CONTEXT_LENGTH; restart Ollama after setup).
OLLAMA_CONTEXT=32768

# Tool set for the local model (3d keeps it small; all needs a large context).
OLLAMA_TOOLS=3d

# ----------------------------------------- Advanced -------------------------------------------------
# Push somewhere else than https://github.com/<GITHUB_USER>/<GITHUB_REPO>.git, e.g. over SSH:
# git@github.com:<GITHUB_USER>/<GITHUB_REPO>.git
GIT_REMOTE_URL=
